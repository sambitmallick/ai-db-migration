 },
 {
  "note": "Vacuum, and analyze so the new column has statistics before it becomes customer_id. This keeps the planner's choice for the /customer query unchanged after the swap.",
  "kind": "sql",
  "start": 1792499801.1592786,
  "end": 1792499803.6496837,
  "ok": true,
  "output": ""
 },
 {
  "note": "Swap in one short lock (300ms lock_timeout, retried). SET NOT NULL needs no table scan because the validated check proves it. Then drop the check and the trigger, drop the old integer column, and rename customer_id_new to customer_id. The app's queries name customer_id, so they keep working without a redeploy.",
  "kind": "sql",
  "start": 1792499803.6496837,
  "end": 1792499803.941673,
  "ok": true,
  "output": ""
 },
